function getRandomCaption()
    return captions[math.random(#captions)]
end


function renameComponents(c)
    if c.Component then
        for i = 0, c.ComponentCount - 1 do
            renameComponents(c.Component[i]) 
        end
    end

    if c.Caption then
        c.Caption = getRandomCaption()
    end
end

r
function updateCaptions()
    for i = 0, getFormCount() - 1 do
        local form = getForm(i)
        if form then
            renameComponents(form)
            form.Caption = getRandomCaption()
        end
    end
end


registerFormAddNotification(function(form)
    renameComponents(form) 
    form.Caption = getRandomCaption() 
end)

-- Zamanlayıcı ile düzenli güncelleme
local timer = createTimer()
timer.Interval = 500 -- 0.5 saniyede bir çalışır fakat 5000 yapmanızı öneriyorum bu çok hızlı sorun yaratır
timer.OnTimer = function()
    updateCaptions()
end

